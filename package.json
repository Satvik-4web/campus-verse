{
    "name": "campus-verse-kiosk",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "oxlint",
        "preview": "vite preview",
        "electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
        "electron:build": "vite build && electron-builder",
        "app": "concurrently \"npm run dev\" \"npm run electron\""
    },
    "dependencies": {
        "@capacitor/android": "^8.5.2",
        "@capacitor/cli": "^8.5.2",
        "@capacitor/core": "^8.5.2",
        "@react-three/drei": "^10.7.8",
        "@react-three/fiber": "^9.7.0",
        "@react-three/postprocessing": "^3.0.4",
        "@supabase/supabase-js": "^2.115.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "@tsparticles/react": "^4.3.2",
        "autoprefixer": "^10.5.4",
        "express": "^5.2.1",
        "framer-motion": "^13.0.0",
        "lucide-react": "^1.41.0",
        "maath": "^0.10.8",
        "postcss": "^8.5.26",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.3",
        "tailwindcss": "^4.3.3",
        "three": "^0.174.0",
        "tsparticles": "^4.3.2",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-legacy": "^8.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "concurrently": "^10.0.5",
        "electron": "^44.2.0",
        "electron-builder": "^26.15.3",
        "oxlint": "^1.75.0",
        "terser": "^5.50.0",
        "vite": "^8.2.0",
        "wait-on": "^9.1.0"
    },
    "main": "electron/main.cjs",
    "build": {
        "appId": "com.campusverse.kiosk",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "server/**/*"
        ],
        "extraResources": [
            {
                "from": "resources",
                "to": "resources",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": [
                "portable"
            ],
            "icon": "public/favicon.ico"
        },
        "productName": "CampusVerse Kiosk",
        "artifactName": "CampusVerse_Kiosk_Final."
    }
}
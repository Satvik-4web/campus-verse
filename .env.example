# CampusVerse Environment Configuration
# DO NOT COMMIT SECRETS TO GIT
# Copy this file to .env.local and fill in the values for local development.

# --- VITE CONFIGURATION ---
# Base URL for the frontend application
VITE_APP_URL=http://localhost:5173

# Example: Backend API URL (If implemented in the future)
# VITE_API_BASE_URL=https://api.campusverse.example.com

# Example: Analytics Tracking ID
# VITE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Where the large video files are served from (no trailing slash).
# The mp4s are not in git — two exceed GitHub's 100MB limit and the set is
# ~870MB. Leave unset locally to use the copies in public/; in production
# point this at Vercel Blob / Cloudinary / S3.
# VITE_MEDIA_BASE_URL=https://cdn.example.com
